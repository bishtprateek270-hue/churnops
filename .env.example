# ChurnOps Environment Configuration Template

# MLflow & Model Registry
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=ChurnOps_Churn_Prediction
MODEL_NAME=ChurnOps-Model

# File System & Artifact Paths
DATA_RAW_DIR=data/raw
DEFAULT_DATA_PATH=data/raw/telco_churn.csv
UPLOAD_DATA_PATH=data/raw/user_upload.csv
MODELS_DIR=models
BEST_MODEL_PATH=models/best_model.joblib
PREPROCESSOR_PATH=models/preprocessor.joblib
UNIFIED_PIPELINE_PATH=models/unified_pipeline.joblib
PREDICTIONS_DB_PATH=monitoring/predictions.db
REPORTS_PLOTS_DIR=reports/plots

# Training & Hyperparameters
TEST_SIZE=0.2
RANDOM_STATE=42
DEFAULT_THRESHOLD=0.5
FAST_MODE_TRIALS=5
FULL_MODE_TRIALS=15

# Business Cost Matrix (FN = False Negative cost, FP = False Positive cost)
COST_FN=500.0
COST_FP=50.0

# Monitoring & Drift Thresholds
DRIFT_P_VALUE_THRESHOLD=0.05
DRIFT_PSI_THRESHOLD=0.2

# FastAPI Server & Security
API_HOST=0.0.0.0
API_PORT=8000
API_KEY_HEADER=X-API-Key
RATE_LIMIT_PER_MINUTE=100
ENABLE_CORS=true
CORS_ORIGINS=*
